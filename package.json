{
  "name": "adventurers-journal",
  "private": true,
  "version": "0.1.0",
  "description": "D&D character sheet and campaign tool",
  "author": "JohanGJensen",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "start": "bun run build && electron .",
    "build": "vite build && bun build electron/main.ts --target=node --format=esm --outdir dist-electron --external electron",
    "test": "bun test",
    "check": "tsc -p tsconfig.json && tsc -p tsconfig.server.json && bun test && bun build scripts/node-smoke.ts --target=node --format=esm --outdir dist-electron && ELECTRON_RUN_AS_NODE=1 electron dist-electron/node-smoke.js",
    "dist": "bun scripts/dist.ts",
    "install:linux": "bun scripts/install-linux.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.5"
  },
  "build": {
    "appId": "dev.jgl.adventurersjournal",
    "productName": "Adventurers Journal",
    "executableName": "adventurers-journal",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/main.js",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage",
        "rpm"
      ],
      "category": "Game",
      "icon": "build/icons",
      "syncDesktopName": true,
      "maintainer": "JohanGJensen"
    },
    "artifactName": "adventurers-journal-${version}.${ext}",
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.role-playing-games",
      "icon": "build/icon.png"
    },
    "dmg": {
      "artifactName": "adventurers-journal-${version}-${arch}.${ext}"
    }
  },
  "desktopName": "adventurers-journal.desktop"
}
